package ui;

import model.ProblemReport;
import model.RepairWorker;
import model.Status;
import service.WorkerAssigner;

import javax.swing.*;
import java.awt.*;
import java.util.ArrayList;
import java.util.List;

public class WorkerPanel extends JPanel {
    private final RepairWorker worker;
    private final WorkerAssigner assigner;
    private final List<ProblemReport> allReports;
    private final DefaultListModel<String> listModel = new DefaultListModel<>();
    private final JList<String> jobList = new JList<>(listModel);
    private List<ProblemReport> myJobs = new ArrayList<>();

    public WorkerPanel(RepairWorker worker, WorkerAssigner assigner,
                       List<ProblemReport> allReports) {
        this.worker = worker;
        this.assigner = assigner;
        this.allReports = allReports;

        setLayout(new BorderLayout());
        add(new JLabel("My jobs"), BorderLayout.NORTH);
        add(new JScrollPane(jobList), BorderLayout.CENTER);

        JButton startButton = new JButton("Start");
        JButton resolvedButton = new JButton("Resolved");
        JPanel buttons = new JPanel();
        buttons.add(startButton);
        buttons.add(resolvedButton);
        add(buttons, BorderLayout.SOUTH);

        startButton.addActionListener(e -> {
            ProblemReport r = selectedReport();
            if (r != null && r.getStatus() == Status.ASSIGNED) {
                assigner.startRepair(r);
                refresh();
            }
        });

        resolvedButton.addActionListener(e -> {
            ProblemReport r = selectedReport();
            if (r != null && r.getStatus() == Status.IN_PROGRESS) {
                assigner.completeRepair(r, worker);
                refresh();
            }
        });

        refresh();
    }

    private ProblemReport selectedReport() {
        int index = jobList.getSelectedIndex();
        if (index < 0) {
            JOptionPane.showMessageDialog(this, "Select a job first.");
            return null;
        }
        return myJobs.get(index);
    }

    public void refresh() {
        listModel.clear();
        myJobs = new ArrayList<>();
        for (ProblemReport r : allReports) {
            if (r.getAssignment() != null
                    && String.valueOf(r.getAssignment().getWorkerId())
                        .equals(String.valueOf(worker.getId()))
                    && r.getStatus() != Status.RESOLVED) {
                myJobs.add(r);
                listModel.addElement("Report " + r.getReportId() + " - "
                        + r.getLocation() + " - " + r.getStatus());
            }
        }
    }
}
